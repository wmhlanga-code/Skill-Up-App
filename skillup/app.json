{
  "expo": {
    "name": "SkillUp",
    "slug": "skill-up",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2B9EE8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skillup.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SkillUp needs your location to show nearby service providers.",
        "NSLocationAlwaysUsageDescription": "SkillUp needs your location to show nearby service providers."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2B9EE8"
      },
      "package": "com.skillup.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "skillup",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SkillUp needs your location to show nearby service providers."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SkillUp to access your photos for your profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2B9EE8",
          "defaultChannel": "default",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6ff125bd-b9c8-4458-8ad8-c3b04db8ac80"
      }
    },
    "owner": "wethus-organization"
  }
}
